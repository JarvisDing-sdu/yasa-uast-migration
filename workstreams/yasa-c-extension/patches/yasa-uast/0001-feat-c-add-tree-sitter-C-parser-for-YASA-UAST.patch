+            assert.deepStrictEqual(decls.map((d: any) => d.id.name), ['a', 'b', 'c']);
+            assert.deepStrictEqual(decls.map((d: any) => d.varType.type), ['PrimitiveType', 'PointerType', 'ArrayType']);
+            assert.strictEqual(body('int x = 1;').length, 1);
+        });
