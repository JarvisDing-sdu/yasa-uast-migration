+    lookup(name: string, offset: number): Array<MacroDefinition | null> {
+        const timeline = this.timelines.get(name);
+        let value: MacroValue = this.unseen;
+        if (timeline) {
+            let lo = 0;
+            let hi = timeline.length - 1;
+            let found = -1;
+            while (lo <= hi) {
+                const mid = (lo + hi) >> 1;
+                if (timeline[mid].offset <= offset) {
