    "instrumented_source": "#include <stdio.h>\nstatic unsigned targets;\ntypedef int (*action)(int);\nstruct callbacks {action left; action right;};\nstatic int red(int x) {targets |= 1; return x + 10;}\nstatic int blue(int x) {targets |= 2; return x + 20;}\nstatic int green(int x) {targets |= 4; return x + 30;}\nstatic int amber(int x) {targets |= 8; return x + 40;}\nstatic struct callbacks board;\nstatic action slot;\nint plain_nested(int a,int b,int x) {\n  action f;\n  if(a) { if(b) f = red; else f = blue; } else f = green;\n  return f(x);\n}\nint global_nested(int a,int b,int x) {\n  slot=red;\n  if(a) {\n    if(b) slot=blue;\n    else slot=green;\n  } else if(b) slot=amber;\n  return slot(x);\n}\nint member_nested(int a,int b,int x) {\n  struct callbacks *p=&board, *q=p;\n  if(a) {\n    if(b) p->left=red; else q->left=blue;\n  } else q->left=green;\n  q->right=amber;\n  return board.left(x)+p->right(x);\n}\nint ptr_to_ptr(int a,int b,int x) {\n  action f=red,*p=&f,**pp=&p;\n  if(a) { if(b) **pp=blue; else *p=green; }\n  return f(x);\n}\nstatic int invoke_arg(action f,int x){return f(x);}\nint callback_param(int a,int b,int x) {\n  action f=red;\n  if(a) {if(b) f=blue; else f=green;}\n  else f=amber;\n  return invoke_arg(f,x);\n}\nint index_select(int a,int b,int x) {\n  action fs[2]; fs[0]=red; fs[1]=blue;\n  if(a) {if(b) fs[0]=green; else fs[1]=amber;}\n  return fs[0](x)+fs[1](x);\n}\nint early(int a,int b,int x){\n  action f=red;\n  if(a) {if(b) return green(x); f=blue;}\n  else f=amber;\n  return f(x);\n}\n\nint main(void) {\n  int (*const cases[])(int,int,int)={plain_nested,global_nested,member_nested,ptr_to_ptr,callback_param,index_select,early};\n  const char *names[]={\"plain_nested\",\"global_nested\",\"member_nested\",\"ptr_to_ptr\",\"invoke_arg\",\"index_select\",\"early\"};\n  for (int i=0;i<7;i++) {\n    targets=0;\n    for(int a=0;a<2;a++) for(int b=0;b<2;b++) cases[i](a,b,12);\n    printf(\"%s %u\\n\",names[i],targets);\n  }\n  return 0;\n}\n"
